APP_NAME="Koperasi Majakara"
APP_ENV=production
APP_KEY=base64:KHkeGAhisQXtAalbAn8oA+5ibQ7HyfpzZ/pJZb4peCA=
APP_DEBUG=false
APP_URL=https://majakara.cloud

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # Production: error saja

# ---- Database (MySQL container) ----
DB_CONNECTION=mysql
DB_HOST=mysql                     # Nama service di docker-compose
DB_PORT=3306
DB_DATABASE=koperasi_majakara
DB_USERNAME=koperasi_user         # Sesuai MYSQL_USER di docker-compose
DB_PASSWORD=GANTI_PASSWORD_KUAT   # Ganti dengan password yang kuat!
DB_ROOT_PASSWORD=GANTI_ROOT_KUAT  # Untuk MYSQL_ROOT_PASSWORD

# ---- Session (Redis) ----
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.majakara.cloud

# ---- Queue (Redis) ----
QUEUE_CONNECTION=redis

# ---- Cache (Redis) ----
CACHE_STORE=redis

# ---- Redis container ----
REDIS_CLIENT=phpredis
REDIS_HOST=redis                  # Nama service di docker-compose
REDIS_PASSWORD=GANTI_REDIS_PASS   # Ganti dengan password Redis!
REDIS_PORT=6379

# ---- Broadcast ----
BROADCAST_CONNECTION=log

# ---- Filesystem ----
FILESYSTEM_DISK=local

# ---- Mail ----
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@majakara.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Fonnte WhatsApp API ----
FONNTE_API_KEY=ISI_API_KEY_FONNTE
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_VERIFY_SSL=true            # Production: true (SSL valid)
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=1
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60

# ---- Tesseract OCR ----
# Tesseract sudah terinstall di container, tidak perlu set path
# TESSERACT_PATH=/usr/bin/tesseract
# TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata

VITE_APP_NAME="${APP_NAME}"
